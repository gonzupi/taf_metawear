        ('./.venv/lib/python3.11/site-packages/PyQt5/Qt5', 'plugins'),
        ('./.venv/lib/python3.11/site-packages/PyQt5/Qt5', 'translations')
    ],
    hiddenimports=[
        'encodings', 'encodings.*',
        'mbientlab', 'mbientlab.metawear', 'mbientlab.warble'
    ],
    hookspath=[],
    runtime_hooks=[],
    excludes=[],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
